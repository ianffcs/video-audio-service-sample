(ns sample.main
  "Video player with background audio - just_audio for audio, video_player for display"
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/widgets.dart" :as w]
            ["package:audio_service/audio_service.dart" :as as]
            ["package:just_audio/just_audio.dart" :as ja]
            ["package:video_player/video_player.dart" :as vp]
            ["package:rxdart/rxdart.dart" :as rx]
            ["dart:async" :as da]
            ["dart:math" :as math]
            [cljd.flutter :as f]))

(def default-video-map
  {::url     "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
   ::art-uri "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/Big_buck_bunny_poster_big.jpg/220px-Big_buck_bunny_poster_big.jpg"
   ::title   "Big Buck Bunny"
   ::album   "Big Buck Bunny"
   ::artist  "Blender Foundation"})

(defn make-media-item
  [{::keys [url
            album
            title
            artist
            art-uri
            duration]}]
  (as/MediaItem
    .id url
    .album album
    .title title
    .artist artist
    .duration ^Duration duration
    .artUri (Uri/parse art-uri)))

(def processing-state->audio-processing-state
  {ja/ProcessingState.idle      as/AudioProcessingState.idle
   ja/ProcessingState.loading   as/AudioProcessingState.loading
   ja/ProcessingState.buffering as/AudioProcessingState.buffering
   ja/ProcessingState.ready     as/AudioProcessingState.ready
   ja/ProcessingState.completed as/AudioProcessingState.completed})

(def playback-system-actions
  #{as/MediaAction.seek
    as/MediaAction.seekForward
    as/MediaAction.seekBackward})

(def android-compact-action-indices
  [0
   1
   3])

(defn controls-for-playing
  [playing]
  [as/MediaControl.rewind
   (if playing
     as/MediaControl.pause
     as/MediaControl.play)
   as/MediaControl.stop
   as/MediaControl.fastForward])

(defn audio-player->playback-context
  [^ja/AudioPlayer audio-player]
  {:processing-state  (.-processingState audio-player)
   :playing           (.-playing audio-player)
   :position          (.-position audio-player)
   :buffered-position (.-bufferedPosition audio-player)
   :speed             (.-speed audio-player)})

(defn playback-state-from-context
  [^ja/PlaybackEvent event
   {:keys [processing-state
           playing
           position
           buffered-position
           speed]}]
  (as/PlaybackState
    .controls (controls-for-playing playing)
    .systemActions playback-system-actions
    .androidCompactActionIndices android-compact-action-indices
    .processingState (get processing-state->audio-processing-state processing-state)
    .playing playing
    .updatePosition position
    .bufferedPosition buffered-position
    .speed speed
    .queueIndex (-> event .-currentIndex)))

(defn duration-ms [^Duration duration]
  (.-inMilliseconds duration))

(defn abs-int [n]
  (if (< n 0)
    (- n)
    n))

(defn format-duration [millis]
  (let [duration (Duration. .milliseconds
                            (int millis))
        hours (.-inHours duration)
        minutes (mod (.-inMinutes duration)
                     60)
        seconds (mod (.-inSeconds duration)
                     60)
        pad #(-> %
                 str
                 (.padLeft 2
                           "0"))]
    (if (> hours
           0)
      (str hours
           ":"
           (pad minutes)
           ":"
           (pad seconds))
      (str (pad minutes)
           ":"
           (pad seconds)))))

(defn SeekBar
  [{::keys [duration
            position
            on-change-end]}]
  (f/widget
    :let [drag-value (atom nil)
          duration-ms (.-inMilliseconds ^Duration duration)
          position-ms (.-inMilliseconds ^Duration position)
          value (or @drag-value
                    position-ms)]
    (m/Column
      .mainAxisSize m/MainAxisSize.min
      .children [(m/Slider
                   .min 0.0
                   .max (double duration-ms)
                   .value (math/min (double value)
                                    (double duration-ms))
                   .onChanged (fn [^double v]
                                (reset! drag-value
                                        (int v))
                                nil)
                   .onChangeEnd (fn [^double v]
                                  (reset! drag-value nil)
                                  (when on-change-end
                                    (on-change-end (Duration. .milliseconds (.round v))))
                                  nil))
                 (m/Text (format-duration value))])))

(deftype MyAudioHandler
  [^ja/AudioPlayer audio-player]
  :extends (as/BaseAudioHandler)
  (play [_]
    (.play audio-player))
  (pause [_]
    (.pause audio-player))
  (stop [_]
    (.stop audio-player))
  ^:mixin as/SeekHandler
  (seek [_ ^Duration duration]
    (.seek audio-player duration)))

(defn VideoPlayerApp
  [{::keys [url]
    :as    video-map}]
  (f/widget
    m/Center
    :managed [audio-player (ja/AudioPlayer)
              video-controller (vp/VideoPlayerController.networkUrl
                                 (Uri/parse url)
                                 .videoPlayerOptions (vp/VideoPlayerOptions .allowBackgroundPlayback true))]
    :let [transform-event (fn [^ja/PlaybackEvent event]
                            (playback-state-from-context
                              event
                              (audio-player->playback-context audio-player)))]
    :watch [^MyAudioHandler? as-handler (as/AudioService.init
                                          .builder (fn [] ^as/AudioHandler
                                                     (->MyAudioHandler ^ja/AudioPlayer audio-player))
                                          .config (as/AudioServiceConfig
                                                    .androidNotificationChannelId "com.app.video.audio"
                                                    .androidNotificationChannelName "Video Audio Service"
                                                    .androidNotificationOngoing true
                                                    .androidShowNotificationBadge true)) :dispose nil]
    :when as-handler
    :let [_pipe-state (.listen (.-playbackEventStream audio-player)
                               (fn [event]
                                 (.add (.-playbackState as-handler)
                                       ^as/PlaybackState (transform-event event))
                                 nil))
          _set-source-and-item (-> (.setAudioSource audio-player (ja/AudioSource.uri (Uri/parse url)))
                                   (.then (fn [^Duration duration]
                                            (.add (.-mediaItem as-handler) (make-media-item (assoc video-map ::duration duration)))
                                            nil)))
          _init-video (-> video-controller
                          .initialize
                          (.then (fn [_]
                                   (.setVolume video-controller 0.0)
                                   (.setLooping video-controller false)
                                   nil)))
          _sync-pos (.listen (.-positionStream audio-player)
                             (fn [^Duration audio-pos]
                               (when (and audio-pos (some-> video-controller .-value .-isInitialized))
                                 (let [video-pos (-> video-controller .-value .-position)
                                       diff-ms (- (.-inMilliseconds audio-pos) (.-inMilliseconds video-pos))
                                       diff-abs (if (< diff-ms 0) (- diff-ms) diff-ms)]
                                   (when (> diff-abs 500)
                                     (.seekTo video-controller audio-pos))))
                               nil))
          _sync-play (.listen (.-playingStream audio-player)
                              (fn [playing]
                                (when (some-> video-controller .-value .-isInitialized)
                                  (if playing
                                    (.play video-controller)
                                    (.pause video-controller)))
                                nil))
          media-stream (-> (rx/Rx.combineLatest2 (.-mediaItem as-handler)
                                                 (as/AudioService.position)
                                                 (fn [media-item position]
                                                   {:media-item media-item
                                                    :position   position}))
                           (.where (fn [m] (some? (:media-item m)))))]
    :when audio-player
    (m/SingleChildScrollView)
    .child
    (m/Padding .padding (m/EdgeInsets.all 16.0))
    .child
    (m/Column .crossAxisAlignment m/CrossAxisAlignment.stretch)
    .children
    [(f/widget
       :watch [_ video-controller]
       :let [value (.-value video-controller)]
       (if (.-isInitialized value)
         (m/AspectRatio
           .aspectRatio (.-aspectRatio value)
           .child (vp/VideoPlayer video-controller))
         (m/Container
           .height 200
           .child (m/Center .child (m/CircularProgressIndicator)))))
     (m/SizedBox .height 20)
     (f/widget
       :watch [item (.-mediaItem as-handler)]
       :when item
       (m/Text (.-title ^as/MediaItem item)
               .style (m/TextStyle .fontSize 20 .fontWeight m/FontWeight.bold)
               .textAlign m/TextAlign.center))
     (m/SizedBox .height 10)
     (f/widget
       :watch [playback-state (.-playbackState as-handler)]
       :when playback-state
       :let [playing (.-playing ^as/PlaybackState playback-state)]
       (m/Row .mainAxisAlignment m/MainAxisAlignment.center)
       .children
       [(m/IconButton
          .icon (m/Icon m/Icons.fast_rewind)
          .iconSize 64
          .onPressed (fn [] (.rewind ^MyAudioHandler as-handler) nil))
        (m/IconButton
          .icon (m/Icon (if playing m/Icons.pause m/Icons.play_arrow))
          .iconSize 64
          .onPressed (fn []
                       (if playing
                         (.pause ^MyAudioHandler as-handler)
                         (.play ^MyAudioHandler as-handler))
                       nil))
        (m/IconButton
          .icon (m/Icon m/Icons.stop)
          .iconSize 64
          .onPressed (fn [] (.stop ^MyAudioHandler as-handler) nil))
        (m/IconButton
          .icon (m/Icon m/Icons.fast_forward)
          .iconSize 64
          .onPressed (fn [] (.fastForward ^MyAudioHandler as-handler) nil))])
     (m/SizedBox .height 10)
     (f/widget
       :watch [ms media-stream]
       :when ms
       (SeekBar {::duration      (or (some-> ^as/MediaItem
                                             (get ms :media-item)
                                             .-duration)
                                     Duration/zero)
                 ::position      (or (some-> ms
                                             :position)
                                     Duration/zero)
                 ::on-change-end (fn [new-pos]
                                   (.seek ^as/SeekHandler as-handler new-pos)
                                   nil)}))
     (m/SizedBox .height 20)
     (f/widget
       :watch [ps (or (some-> ^as/AudioHandler as-handler
                              .-playbackState
                              (.map (fn [st] (.-playing ^as/PlaybackState st)))
                              (.distinct))
                      as/AudioProcessingState.idle)]
       (m/Text (str "Playing: " ps) .textAlign m/TextAlign.center))
     (m/SizedBox .height 10)
     (m/Card
       .child
       (m/Padding
         .padding (m/EdgeInsets.all 16.0)
         .child (m/Column
                  .crossAxisAlignment m/CrossAxisAlignment.start
                  .children [(m/Text "Background Audio Features:"
                                     .style (m/TextStyle
                                              .fontWeight m/FontWeight.bold))
                             (m/SizedBox .height 8)
                             (m/Text "• Audio via just_audio (background support)")
                             (m/Text "• Video display via video_player (muted)")
                             (m/Text "• Lock screen controls available")
                             (m/Text "• Audio continues when minimized")])))]))

;; Main entry point
(defn ^:async main []
  (.ensureInitialized w/WidgetsFlutterBinding)
  (f/run
    (m/MaterialApp
      .title "Video + Audio Service")
    .home
    (m/Scaffold
      .appBar (m/AppBar .title (m/Text "Video with Background Audio")))
    .body
    (VideoPlayerApp default-video-map)))
