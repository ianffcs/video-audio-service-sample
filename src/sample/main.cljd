(ns sample.main
  "Video player with background audio - just_audio for audio, video_player for display"
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/widgets.dart" :as w]
            [cljd.flutter :as f]
            [ianffcs.video-player :as vpl]))

(defn default-layout
  "Returns a vector of widgets for the default player layout."
  [initialized-video]
  [(vpl/VideoLoader initialized-video)
   (m/SizedBox .height 20)
   (vpl/BasicTitle initialized-video)
   (m/SizedBox .height 10)
   (vpl/PlayerControls initialized-video)
   (m/SizedBox .height 10)
   (vpl/SeekBar initialized-video)
   (m/SizedBox .height 20)
   (vpl/PlayerState initialized-video)])

(defn SamplePlayerView
  "Renders an initialized video map using default-layout."
  [initialized-video]
  (m/SingleChildScrollView
    .child
    (m/Padding
      .padding (m/EdgeInsets.all 16.0)
      .child
      (m/Column
        .crossAxisAlignment m/CrossAxisAlignment.stretch
        .children (default-layout initialized-video)))))

;; Main entry point
(defn ^:async main []
  (.ensureInitialized w/WidgetsFlutterBinding)
  (let [video-config {::vpl/url     "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                      ::vpl/art-uri "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/Big_buck_bunny_poster_big.jpg/220px-Big_buck_bunny_poster_big.jpg"
                      ::vpl/title   "Big Buck Bunny"
                      ::vpl/album   "Big Buck Bunny"
                      ::vpl/artist  "Blender Foundation"}]
    (f/run
      (m/MaterialApp .title "Video + Audio Service")
      .home (m/Scaffold
              .appBar (m/AppBar .title (m/Text "Video with Background Audio")))
      .body (some->> SamplePlayerView
                     (assoc video-config ::vpl/builder)
                     vpl/VideoPlayer))))
