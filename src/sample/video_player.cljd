(ns sample.video-player
  "Non-widget video player logic: audio handler, media items, playback state, utilities."
  (:require ["package:flutter/material.dart" :as m]
            ["package:audio_service/audio_service.dart" :as as]
            ["package:just_audio/just_audio.dart" :as ja]
            ["package:video_player/video_player.dart" :as vp]
            ["package:rxdart/rxdart.dart" :as rx]
            ["dart:math" :as math]
            [cljd.flutter :as f]))

(defn format-duration [millis]
  (let [duration (Duration. .milliseconds
                            (int millis))
        hours (.-inHours duration)
        minutes (mod (.-inMinutes duration)
                     60)
        seconds (mod (.-inSeconds duration)
                     60)
        pad #(-> %
                 str
                 (.padLeft 2
                           "0"))]
    (if (> hours
           0)
      (str hours
           ":"
           (pad minutes)
           ":"
           (pad seconds))
      (str (pad minutes)
           ":"
           (pad seconds)))))

(def processing-state->audio-processing-state
  {ja/ProcessingState.idle      as/AudioProcessingState.idle
   ja/ProcessingState.loading   as/AudioProcessingState.loading
   ja/ProcessingState.buffering as/AudioProcessingState.buffering
   ja/ProcessingState.ready     as/AudioProcessingState.ready
   ja/ProcessingState.completed as/AudioProcessingState.completed})

(def playback-system-actions
  #{as/MediaAction.seek
    as/MediaAction.seekForward
    as/MediaAction.seekBackward})

(defn audio-player->playback-context
  [^ja/AudioPlayer audio-player]
  {:processing-state  (.-processingState audio-player)
   :playing           (.-playing audio-player)
   :position          (.-position audio-player)
   :buffered-position (.-bufferedPosition audio-player)
   :speed             (.-speed audio-player)})

(def android-compact-action-indices
  [0
   1
   3])

(defn controls-for-playing
  [playing]
  [as/MediaControl.rewind
   (if playing
     as/MediaControl.pause
     as/MediaControl.play)
   as/MediaControl.stop
   as/MediaControl.fastForward])

(deftype MyAudioHandler
  [^ja/AudioPlayer audio-player]
  :extends (as/BaseAudioHandler)
  (play [_]
    (.play audio-player))
  (pause [_]
    (.pause audio-player))
  (stop [_]
    (.stop audio-player))
  ^:mixin as/SeekHandler
  (seek [_ ^Duration duration]
    (.seek audio-player duration)))

(defn make-media-item
  [{::keys [url
            album
            title
            artist
            art-uri
            duration]}]
  (as/MediaItem
    .id url
    .album album
    .title title
    .artist artist
    .duration ^Duration duration
    .artUri (Uri/parse art-uri)))

(defn playback-state-from-context
  [^ja/PlaybackEvent event
   {:keys [processing-state
           playing
           position
           buffered-position
           speed]}]
  (as/PlaybackState
    .controls (controls-for-playing playing)
    .systemActions playback-system-actions
    .androidCompactActionIndices android-compact-action-indices
    .processingState (get processing-state->audio-processing-state processing-state)
    .playing playing
    .updatePosition position
    .bufferedPosition buffered-position
    .speed speed
    .queueIndex (-> event .-currentIndex)))

(defn transform-event
  [^ja/AudioPlayer audio-player ^ja/PlaybackEvent event]
  (playback-state-from-context
    event
    (audio-player->playback-context audio-player)))

(defn setup-player
  [{::keys [url
            audio-player
            video-controller
            audio-service-handler]
    :as    video-map}]
  (let [^ja/AudioPlayer audio-player audio-player
        ^vp/VideoPlayerController video-controller video-controller
        ^MyAudioHandler audio-service-handler audio-service-handler
        pipe-state (.listen (.-playbackEventStream audio-player)
                            (fn [event]
                              (.add (.-playbackState audio-service-handler)
                                    ^as/PlaybackState (transform-event audio-player event))
                              nil))
        set-source-and-item (-> (.setAudioSource audio-player (ja/AudioSource.uri (Uri/parse url)))
                                (.then (fn [^Duration duration]
                                         (.add (.-mediaItem audio-service-handler) (make-media-item (assoc video-map ::duration duration)))
                                         nil)))
        init-video (-> video-controller
                       .initialize
                       (.then (fn [_]
                                (.setVolume video-controller 0.0)
                                (.setLooping video-controller false)
                                nil)))
        sync-pos (.listen (.-positionStream audio-player)
                          (fn [^Duration audio-pos]
                            (when (and audio-pos (some-> video-controller .-value .-isInitialized))
                              (let [video-pos (-> video-controller .-value .-position)
                                    diff-ms (- (.-inMilliseconds audio-pos) (.-inMilliseconds video-pos))
                                    diff-abs (if (< diff-ms 0) (- diff-ms) diff-ms)]
                                (when (> diff-abs 500)
                                  (.seekTo video-controller audio-pos))))
                            nil))
        sync-play (.listen (.-playingStream audio-player)
                           (fn [playing]
                             (when (some-> video-controller .-value .-isInitialized)
                               (if playing
                                 (.play video-controller)
                                 (.pause video-controller)))
                             nil))
        media-stream (.where (rx/Rx.combineLatest2
                               (.-mediaItem audio-service-handler)
                               (as/AudioService.position)
                               (fn [media-item position]
                                 {:media-item media-item
                                  :position   position}))
                             (fn [m] (some? (:media-item m))))]
    (assoc video-map
      ::pipe-state pipe-state
      ::set-source-and-item set-source-and-item
      ::init-video init-video
      ::sync-pos sync-pos
      ::sync-play sync-play
      ::media-stream media-stream)))

(defn init-audio-service
  [audio-player]
  (as/AudioService.init
    .builder (fn [] ^as/AudioHandler
               (->MyAudioHandler ^ja/AudioPlayer audio-player))
    .config (as/AudioServiceConfig
              .androidNotificationChannelId "com.app.video.audio"
              .androidNotificationChannelName "Video Audio Service"
              .androidNotificationOngoing true
              .androidShowNotificationBadge true)))

(defn player-actions
  "Returns a map of playback callbacks for a given audio handler."
  [^MyAudioHandler handler]
  {::on-rewind       (fn [] (.rewind handler) nil)
   ::on-play         (fn [] (.play handler) nil)
   ::on-pause        (fn [] (.pause handler) nil)
   ::on-stop         (fn [] (.stop handler) nil)
   ::on-fast-forward (fn [] (.fastForward handler) nil)})

(defn VideoLoader
  [{::keys [video-controller]}]
  (f/widget
    :watch [_ video-controller]
    :let [value (.-value ^vp/VideoPlayerController video-controller)]
    (if (.-isInitialized value)
      (m/AspectRatio
        .aspectRatio (.-aspectRatio value)
        .child (vp/VideoPlayer video-controller))
      (m/Container
        .height 200
        .child (m/Center .child (m/CircularProgressIndicator))))))

(defn PlayerControls
  [{::keys [audio-service-handler]}]
  (f/widget
    :watch [playback-state (.-playbackState ^MyAudioHandler audio-service-handler)]
    :when playback-state
    :let [playing (.-playing ^as/PlaybackState playback-state)
          {::keys [on-rewind on-play on-pause on-stop on-fast-forward]} (player-actions audio-service-handler)]
    (m/Row .mainAxisAlignment m/MainAxisAlignment.center)
    .children
    [(m/IconButton
       .icon (m/Icon m/Icons.fast_rewind)
       .iconSize 64
       .onPressed on-rewind)
     (m/IconButton
       .icon (m/Icon (if playing m/Icons.pause m/Icons.play_arrow))
       .iconSize 64
       .onPressed (if playing on-pause on-play))
     (m/IconButton
       .icon (m/Icon m/Icons.stop)
       .iconSize 64
       .onPressed on-stop)
     (m/IconButton
       .icon (m/Icon m/Icons.fast_forward)
       .iconSize 64
       .onPressed on-fast-forward)]))

(defn PlayerState
  [{::keys [audio-player
            audio-service-handler]}]
  (f/widget
    :when audio-player
    :watch [ps (or (some-> ^as/AudioHandler audio-service-handler
                           .-playbackState
                           (.map (fn [st] (.-playing ^as/PlaybackState st)))
                           (.distinct))
                   as/AudioProcessingState.idle)]
    (m/Text (str "Playing: " ps) .textAlign m/TextAlign.center)))

(defn BasicTitle
  [{::keys [audio-service-handler]}]
  (f/widget
    :watch [item (.-mediaItem ^MyAudioHandler audio-service-handler)]
    :when item
    (m/Text (.-title ^as/MediaItem item)
            .style (m/TextStyle .fontSize 20 .fontWeight m/FontWeight.bold)
            .textAlign m/TextAlign.center)))

(defn SeekBar
  [{::keys [on-change-end
            media-stream]}]
  (f/widget
    :watch [ms media-stream]
    :when ms
    :let [position (or (some-> ms
                               :position)
                       Duration/zero)
          duration (or (some-> ^as/MediaItem
                               (get ms :media-item)
                               .-duration)
                       Duration/zero)
          drag-value (atom nil)
          duration-ms (.-inMilliseconds ^Duration duration)
          position-ms (.-inMilliseconds ^Duration position)
          value (or @drag-value
                    position-ms)]
    (m/Column
      .mainAxisSize m/MainAxisSize.min
      .children [(m/Slider
                   .min 0.0
                   .max (double duration-ms)
                   .value (math/min (double value)
                                    (double duration-ms))
                   .onChanged (fn [^double v]
                                (reset! drag-value
                                        (int v))
                                nil)
                   .onChangeEnd (fn [^double v]
                                  (reset! drag-value nil)
                                  (when on-change-end
                                    (on-change-end (Duration. .milliseconds (.round v))))
                                  nil))
                 (m/Text (format-duration value))])))
